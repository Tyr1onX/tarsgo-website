APP_ENV=development
APP_PORT=8080
GIN_MODE=debug
# Keep true for local development. Set false for production web processes and
# run the version-matched dist/tarsgo-migrate binary once during deployment.
APP_AUTO_MIGRATE=true
# 留空时 OAuth 回跳使用同源相对路径，适合单二进制部署。
# 分离式前端开发时可设为 http://127.0.0.1:5173。
APP_FRONTEND_URL=

DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=tarsgo
DB_USER=tarsgo
# Development-only placeholder. Generate a unique secret for every environment.
DB_PASSWORD=tarsgo_dev_change_me
DB_CHARSET=utf8mb4
DB_PARSE_TIME=true
DB_LOC=Local
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=20
DB_CONN_MAX_LIFETIME_MINUTES=30

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5180,http://localhost:5180

# Development-only placeholder; production must use a long random value.
JWT_SECRET=tarsgo-dev-jwt-secret-change-this
JWT_COOKIE_NAME=tarsgo_token
JWT_OAUTH_STATE_COOKIE_NAME=tarsgo_oauth_state
JWT_EXPIRES_HOURS=72
JWT_COOKIE_MAX_AGE_SECONDS=259200
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=lax

# Server-only email credentials. Never expose this key to the frontend or Git.
RESEND_API_KEY=
EMAIL_FROM="吉甲大师 <noreply@jijiamaster.com>"
